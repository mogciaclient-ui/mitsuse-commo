rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /surveyResponses/{responseId} {
      allow create: if
        request.resource.data.keys().hasOnly(['storeGroup', 'store', 'birthDate', 'message', 'source', 'schemaVersion', 'createdAt']) &&
        request.resource.data.storeGroup is string && request.resource.data.storeGroup.size() <= 40 &&
        request.resource.data.store is string && request.resource.data.store.size() <= 80 &&
        request.resource.data.birthDate is string && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.message is string && request.resource.data.message.size() <= 1000 &&
        request.resource.data.source == 'line-survey' &&
        request.resource.data.schemaVersion == 1 &&
        request.resource.data.createdAt == request.time;

      allow read: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
